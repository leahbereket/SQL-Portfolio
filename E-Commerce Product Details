

Top Selling Products
--------------------

select p.product_id,
p2.product_name,
count (p.product_id) as purchase_count
from purchases p
left join products p2 
on p.product_id = p2.product_id 
group by p.product_id,
p2.product_name 
order by "purchase_count" desc;


Most Frequently Repurchased Products
------------------------------------

select p.product_id,
p2.product_name,
count (*) as repeat_customers
from (
	select
		product_id,
		user_id
		from purchases p 
		group by
			product_id,
			p.user_id 
		having count(order_id) >= 2
	) p
	left join products p2
		on p.product_id = p2.product_id 	
	group by
		p.product_id,
		p2.product_name 
	order by repeat_customers desc;


Average Time Between Session Start Time & Order Time
----------------------------------------------------

select
AVG(p.order_date::timestamp - s.start_time::timestamp) AS time_difference
from purchases p
left join sessions s
on p.session_id = s.session_id; 
		

Number of Sales by Hour of Day
-------------------------------

select extract(hour from order_time::time) as hour_of_day,
count(*) as number_of_sales
from purchases p
group by extract(hour from order_time::time);


