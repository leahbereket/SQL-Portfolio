AVG difference between 2011 vs 2021 GNIPC of very high, high, medium and low human development groups

SELECT "Human Development Groups",
AVG("Gross National Income Per Capita (2011)") as avg_gnipc_2011,
AVG("Gross National Income Per Capita (2021)") as avg_gnipc_2021
FROM gnipc
where "Human Development Groups" is not null
	and TRIM("Human Development Groups") <> ''
group by "Human Development Groups"
order by "avg_gnipc_2011" desc;
